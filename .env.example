SITE_URL=https://suisen.page
AMAZON_ASSOCIATE_TAG=
RAKUTEN_AFFILIATE_ID=
# 書影・書誌取得スクリプト（pnpm fetch-books）用。ビルドでは使わない。
# .env に書かず、実行時に macOS キーチェーンから渡してもよい（README 参照）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# 楽天のアプリに登録した参照元 URL（未設定なら SITE_URL を使う）
RAKUTEN_HTTP_REFERER=
# 訂正依頼の窓口・運営者名（公開前に設定）
CONTACT_EMAIL=
OPERATOR_NAME=
