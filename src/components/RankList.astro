---
import BookCover from "./BookCover.astro";
import type { RankedBook, Rec } from "../lib/data";
import { authorsLabel, formatDate } from "../lib/site";

interface Props {
  items: RankedBook[];
  sourcesByIsbn?: Map<string, Rec[]>;
}
const { items, sourcesByIsbn } = Astro.props;
---

<ol class="rank-list">
  {
    items.map(({ rank, book, count }, i) => (
      <li class="rank-row">
        <span class="rank"><span class="visually-hidden">第</span>{rank}<span class="visually-hidden">位</span></span>
        <a class="cover-link" href={`/books/${book.isbn13}/`} tabindex="-1" aria-hidden="true">
          <BookCover book={book} width={64} eager={i === 0} />
        </a>
        <div>
          <h2 class="h3">
            <a href={`/books/${book.isbn13}/`}>{book.title}</a>
          </h2>
          <p class="small secondary">{authorsLabel(book.authors)}</p>
          <p class="caption tertiary num">推薦 {count}人</p>
          {sourcesByIsbn && (
            <ul aria-label="推薦者と出典">
              {sourcesByIsbn.get(book.isbn13)?.map(({ person, context, source }) => (
                <li class="small rec-source">
                  {person.name}（{context}）<br />
                  <a href={source.url}>{source.title}</a>
                  <span class="caption secondary"> ／ {source.media}{source.publishedAt && `・${formatDate(source.publishedAt)}`}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
