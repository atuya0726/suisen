---
import type { Crumb } from "../lib/site";

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs caption secondary" aria-label="パンくずリスト">
  <ol>
    {
      items.map((item) => (
        <li>{item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>
      ))
    }
  </ol>
</nav>
