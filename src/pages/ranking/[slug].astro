---
// /ranking/2/（総合の2ページ目以降）と /ranking/executive/（属性別）を1つのルートで生成する。
// 動的ルートを2ファイルに分けると同じパスを取り合うため。
import type { GetStaticPaths } from "astro";
import RankingPage from "../../components/RankingPage.astro";
import { paginate, ranking, tagRankings } from "../../lib/data";
import { RANKING_PAGE_SIZE } from "../../lib/site";

export const getStaticPaths = (() => [
  ...paginate(ranking, RANKING_PAGE_SIZE)
    .map((_, i) => i + 1)
    .filter((page) => page > 1)
    .map((page) => ({ params: { slug: String(page) }, props: { page, tagSlug: undefined } })),
  ...tagRankings.map((t) => ({ params: { slug: t.slug }, props: { page: 1, tagSlug: t.slug } })),
]) satisfies GetStaticPaths;

const { page, tagSlug } = Astro.props;
---

<RankingPage page={page} tagSlug={tagSlug} />
